generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  HR_ADMIN
  FINANCE
  BUSINESS_HEAD
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  SUSPENDED
  ON_LEAVE
  SICK_LEAVE
  FIRED
  RESIGNED
}

enum EmployeeSex {
  MALE
  FEMALE
}

enum EmploymentType {
  FULL_TIME
  CONTRACT
}

enum JobListingStatus {
  DRAFT
  OPEN
  CLOSED
  FILLED
}

enum JobApplicationStatus {
  NEW
  REVIEWING
  INTERVIEW
  ASSESSMENT
  SHORTLISTED
  OFFER
  REJECTED
  HIRED
}

enum JobBoard {
  CAREERS_PAGE
  LINKEDIN
  INDEED
  JOBBERMAN
  HOT_NIGERIAN_JOBS
  OTHER
}

enum JobListingPostStatus {
  READY
  POSTED
  FAILED
}

enum PayrollRunStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  FORWARDED_TO_FINANCE
  PROCESSING
  PAID
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  UNPAID
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Company {
  id             String   @id @default(cuid())
  name           String
  address        String?
  logoUrl        String?
  /// Primary accent (hex, e.g. #fce74f). Null = Blackcountry yellow default.
  brandAccentHex String?
  /// Sidebar / ink color (hex). Null = Blackcountry black #292929.
  brandInkHex    String?
  /// Group company: null. Sub-company: parent group or parent sub-company id.
  parentId       String?
  parent         Company?  @relation("CompanyGroup", fields: [parentId], references: [id], onDelete: Restrict)
  subsidiaries   Company[] @relation("CompanyGroup")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  statutoryConfig       StatutoryConfig?
  users                 User[]
  employees             Employee[]
  departments           Department[]
  payrollRuns           PayrollRun[]
  taxBands              TaxBand[]
  googleDriveIntegration GoogleDriveIntegration?
  microsoftWorkspaceIntegration MicrosoftWorkspaceIntegration?
  notifications         Notification[]
  shiftTemplates        ShiftTemplate[]
  attendanceSettings    AttendanceSettings?
  attendancePunches     AttendancePunch[]
  attendanceDays        AttendanceDay[]
  companyHolidays       CompanyHoliday[]
  overtimeRequests      OvertimeRequest[]
  shiftExceptions       ShiftException[]
  hrDeskMessages        HrDeskMessage[]
  employeeLifecycles    EmployeeLifecycle[]
  changeRequests        EmployeeChangeRequest[]
  jobDescriptions       JobDescription[]
  projects              Project[]
  workScheduleEntries   WorkScheduleEntry[]
  timesheetEntries      TimesheetEntry[]
  timesheetWeeks        TimesheetWeek[]
  workspaceFiles        WorkspaceFile[]
  jobListings           JobListing[]
  jobApplications       JobApplication[]
  skills                Skill[]
  assets                CompanyAsset[]
  trainingPrograms      TrainingProgram[]
  performanceGoals      PerformanceGoal[]
  performanceReviews    PerformanceReview[]
  recognitions          Recognition[]
  salaryStructures      SalaryStructure[]
  benefitPlans          BenefitPlan[]
  recurringDeductions   RecurringDeduction[]
  salaryAdvances        SalaryAdvance[]
  salaryLoans           SalaryLoan[]
  remittancePayments    RemittancePayment[]
  expenseClaims         ExpenseClaim[]
  automationSettings    AutomationSettings?
  automationJobLogs     AutomationJobLog[]
  webhookEndpoints      WebhookEndpoint[]

  @@index([parentId])
}

model Department {
  id                 String    @id @default(cuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String
  managerEmployeeId  String?
  manager            Employee? @relation("DepartmentHead", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([managerEmployeeId])
}

model JobDescription {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model StatutoryConfig {
  id                    String  @id @default(cuid())
  companyId             String  @unique
  company               Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Pension rates (basis points: 800 = 8%)
  pensionEmployeeRate   Int     @default(800)
  pensionEmployerRate   Int     @default(1000)
  pensionBasis          String  @default("BASIC_HOUSING_TRANSPORT")

  // NHF
  nhfEnabled            Boolean @default(true)
  nhfRate               Int     @default(250) // 2.5%

  // NSITF (employer only)
  nsitfRate             Int     @default(100) // 1%

  // Tax relief mode: NTA2025 (tax-free threshold) or CRA (legacy)
  taxReliefMode         String  @default("NTA2025")
  taxFreeThresholdKobo  BigInt  @default(80000000) // ₦800,000 annual
  craFixedKobo          BigInt  @default(20000000) // ₦200,000 (legacy CRA)
  craPercentBps         Int     @default(100)      // 1% of gross
  craGrossPercentBps    Int     @default(2000)     // 20% of gross
  rentReliefCapKobo     BigInt  @default(50000000) // ₦500,000
  minimumWageExemptKobo BigInt  @default(84000000) // ₦840,000 annual (₦70k/month)
  /// Payable working days used for unpaid leave / attendance daily rates
  workingDaysPerMonth   Int     @default(22)

  updatedAt             DateTime @updatedAt
}

model TaxBand {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lowerBoundKobo BigInt
  upperBoundKobo BigInt? // null = no upper limit
  rateBps     Int     // 1500 = 15%
  sortOrder   Int
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?

  @@index([companyId, sortOrder])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId   String?  @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payrollRunsCreated  PayrollRun[] @relation("CreatedBy")
  payrollRunsApproved PayrollRun[] @relation("ApprovedBy")
  leaveApprovals      LeaveRequest[] @relation("LeaveApprover")
  overtimeApprovals   OvertimeRequest[] @relation("OvertimeApprover")
  advanceApprovals    SalaryAdvance[] @relation("AdvanceApprover")
  loanApprovals       SalaryLoan[] @relation("LoanApprover")
  expenseApprovals    ExpenseClaim[] @relation("ExpenseApprover")
  expenseReimbursements ExpenseClaim[] @relation("ExpenseReimburser")
  auditLogs           AuditLog[]
  notifications       Notification[]
  hrDeskAssigned      HrDeskMessage[] @relation("HrDeskAssignee")
  timesheetWeeksValidated TimesheetWeek[] @relation("TimesheetWeekValidator")
  jobListingsCreated      JobListing[]    @relation("JobListingCreator")
  taskComments            ProjectTaskComment[]
  recognitionsGiven       Recognition[] @relation("RecognitionGiver")
}

model Employee {
  id                  String         @id @default(cuid())
  companyId           String
  company             Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeCode        String
  firstName           String
  lastName            String
  department          String
  jobTitle            String
  employmentType      EmploymentType @default(FULL_TIME)
  status              EmployeeStatus @default(ACTIVE)
  sex                 EmployeeSex?
  startDate           DateTime
  endDate             DateTime?

  // Bank & statutory IDs
  bankName            String?
  bankAccountNumber   String?
  tin                 String?
  rsaPin              String?
  nhfNumber           String?

  // Compensation (all in kobo) — engine reads these fields, not the structure row
  basicSalaryKobo     BigInt
  housingAllowanceKobo BigInt @default(0)
  transportAllowanceKobo BigInt @default(0)
  otherTaxableAllowancesKobo BigInt @default(0)
  nonTaxableReimbursementsKobo BigInt @default(0)
  salaryStructureId   String?
  salaryStructure     SalaryStructure? @relation(fields: [salaryStructureId], references: [id], onDelete: SetNull)

  // Optional rent for NTA2025 relief
  annualRentKobo      BigInt @default(0)

  nextOfKinName       String?
  nextOfKinPhone      String?
  emergencyContactName  String?
  emergencyContactPhone String?
  dateOfBirth         DateTime?
  probationEnd        DateTime?
  workLocation        String?
  managerId           String?
  manager             Employee?  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports             Employee[] @relation("EmployeeManager")
  /// Work / login email shown on the staff record (portal User.email is source of truth)
  workEmail           String?
  phone               String?
  addressLine         String?

  // Biometric / clock-in machine badge or user ID
  clockDeviceId       String?

  user                User?
  documents           EmployeeDocument[]
  payslips            Payslip[]
  leaveRequests       LeaveRequest[]
  leaveBalances       LeaveBalance[]
  payrollAdjustments  PayrollAdjustment[]
  shiftAssignment     EmployeeShiftAssignment?
  attendancePunches   AttendancePunch[]
  attendanceDays      AttendanceDay[]
  overtimeRequests    OvertimeRequest[]
  shiftExceptions     ShiftException[]
  hrDeskMessages      HrDeskMessage[]
  lifecycles          EmployeeLifecycle[]
  changeRequests      EmployeeChangeRequest[]
  timesheetEntries    TimesheetEntry[]
  timesheetWeeks      TimesheetWeek[]
  workspaceFileGrants WorkspaceFileGrant[]
  hiredApplications   JobApplication[]
  skills              EmployeeSkill[]
  certifications      EmployeeCertification[]
  assignedAssets      CompanyAsset[]
  managedDepartments  Department[] @relation("DepartmentHead")
  trainingEnrollments TrainingEnrollment[]
  performanceGoals    PerformanceGoal[]
  performanceReviews  PerformanceReview[]
  peerReviews         PerformanceReview[] @relation("ReviewPeer")
  recognitions        Recognition[]
  employeeBenefits    EmployeeBenefit[]
  recurringDeductions RecurringDeduction[]
  salaryAdvances      SalaryAdvance[]
  salaryLoans         SalaryLoan[]
  expenseClaims       ExpenseClaim[]
  managedProjects     Project[] @relation("ProjectManager")
  projectMemberships  ProjectMember[]
  assignedTasks       ProjectTask[] @relation("TaskAssignee")
  workScheduleEntries WorkScheduleEntry[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([companyId, employeeCode])
  @@unique([companyId, clockDeviceId])
  @@index([companyId, status])
  @@index([managerId])
  @@index([salaryStructureId])
}

model EmployeeDocument {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name       String
  fileUrl    String
  category   String    @default("OTHER")
  expiresAt  DateTime?
  uploadedAt DateTime  @default(now())
}

model Skill {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  employees   EmployeeSkill[]
  jobListings JobListingSkill[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model EmployeeSkill {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level      String   @default("INTERMEDIATE")

  @@unique([employeeId, skillId])
}

model EmployeeCertification {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name       String
  issuer     String?
  issuedAt   DateTime?
  expiresAt  DateTime?
  fileUrl    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([employeeId, expiresAt])
}

model CompanyAsset {
  id                 String    @id @default(cuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assetCode          String
  name               String
  assetType          String
  status             String    @default("AVAILABLE")
  serialNumber       String?
  valueKobo          BigInt    @default(0)
  purchasedAt        DateTime?
  assignedEmployeeId String?
  assignedEmployee   Employee? @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  assignedAt         DateTime?
  condition          String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([companyId, assetCode])
  @@index([companyId, status])
  @@index([assignedEmployeeId])
}

model PayrollRun {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodMonth Int
  periodYear  Int
  status      PayrollRunStatus @default(DRAFT)
  createdById String
  createdBy   User             @relation("CreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy  User?            @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt  DateTime?
  paidAt      DateTime?
  forwardedAt DateTime?
  processedAt DateTime?
  notes       String?
  /// Snapshot of statutory rates + tax bands used when this run was calculated/approved
  statutorySnapshot Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  payslips    Payslip[]
  adjustments PayrollAdjustment[]
  overtimeRequests OvertimeRequest[]
  advanceCharges SalaryAdvanceCharge[]
  loanCharges    SalaryLoanCharge[]
  remittancePayments RemittancePayment[]
  expenseClaims      ExpenseClaim[]

  @@unique([companyId, periodMonth, periodYear])
  @@index([companyId, status])
}

model PayrollAdjustment {
  id            String     @id @default(cuid())
  payrollRunId  String
  payrollRun    PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type          String     // BONUS, LOAN_DEDUCTION, ADVANCE, UNPAID_LEAVE, OVERTIME, ATTENDANCE_PENALTY, BENEFIT_DEDUCTION, COOPERATIVE, CUSTOM_DEDUCTION
  amountKobo    BigInt     // positive = earning, negative = deduction
  description   String?
  createdAt     DateTime   @default(now())

  @@index([payrollRunId, employeeId])
}

model Payslip {
  id                  String     @id @default(cuid())
  payrollRunId        String
  payrollRun          PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  grossPayKobo        BigInt
  basicSalaryKobo     BigInt
  housingAllowanceKobo BigInt
  transportAllowanceKobo BigInt
  otherAllowancesKobo BigInt
  bonusesKobo         BigInt @default(0)

  payeKobo            BigInt
  pensionEmployeeKobo BigInt
  pensionEmployerKobo BigInt
  nhfKobo             BigInt @default(0)
  nsitfKobo           BigInt @default(0)
  otherDeductionsKobo BigInt @default(0)

  netPayKobo          BigInt

  // YTD snapshots at time of generation
  ytdGrossKobo        BigInt @default(0)
  ytdPayeKobo         BigInt @default(0)
  ytdNetKobo          BigInt @default(0)

  breakdown           Json?
  generatedAt         DateTime @default(now())

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

/// Template copied onto Employee compensation fields when assigned. Engine still reads the employee row.
model SalaryStructure {
  id                             String     @id @default(cuid())
  companyId                      String
  company                        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                           String
  basicSalaryKobo                BigInt
  housingAllowanceKobo           BigInt     @default(0)
  transportAllowanceKobo         BigInt     @default(0)
  feedingAllowanceKobo           BigInt     @default(0)
  medicalAllowanceKobo           BigInt     @default(0)
  communicationAllowanceKobo     BigInt     @default(0)
  otherTaxableAllowancesKobo     BigInt     @default(0)
  nonTaxableReimbursementsKobo   BigInt     @default(0)
  employees                      Employee[]
  createdAt                      DateTime   @default(now())
  updatedAt                      DateTime   @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model BenefitPlan {
  id                    String            @id @default(cuid())
  companyId             String
  company               Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                  String
  kind                  String            @default("OTHER")
  employerCostKobo      BigInt            @default(0)
  employeeDeductionKobo BigInt            @default(0)
  notes                 String?
  enrollments           EmployeeBenefit[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model EmployeeBenefit {
  id         String      @id @default(cuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  planId     String
  plan       BenefitPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  status     String      @default("ACTIVE")
  startedAt  DateTime    @default(now())
  endedAt    DateTime?

  @@unique([employeeId, planId])
  @@index([planId])
}

model RecurringDeduction {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind        String   @default("OTHER")
  amountKobo  BigInt
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, status])
  @@index([employeeId])
}

model SalaryAdvance {
  id               String                @id @default(cuid())
  companyId        String
  company          Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requestedKobo    BigInt
  approvedKobo     BigInt                @default(0)
  installments     Int                   @default(1)
  reason           String?
  status           String                @default("PENDING")
  approvedById     String?
  approvedBy       User?                 @relation("AdvanceApprover", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  charges          SalaryAdvanceCharge[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([companyId, status])
  @@index([employeeId])
}

model SalaryAdvanceCharge {
  id           String        @id @default(cuid())
  advanceId    String
  advance      SalaryAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  payrollRunId String
  payrollRun   PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  amountKobo   BigInt

  @@unique([advanceId, payrollRunId])
  @@index([payrollRunId])
}

model SalaryLoan {
  id            String             @id @default(cuid())
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  principalKobo BigInt
  interestKobo  BigInt             @default(0)
  installments  Int                @default(1)
  reason        String?
  status        String             @default("PENDING")
  approvedById  String?
  approvedBy    User?              @relation("LoanApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  charges       SalaryLoanCharge[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([companyId, status])
  @@index([employeeId])
}

model SalaryLoanCharge {
  id           String     @id @default(cuid())
  loanId       String
  loan         SalaryLoan @relation(fields: [loanId], references: [id], onDelete: Cascade)
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  amountKobo   BigInt

  @@unique([loanId, payrollRunId])
  @@index([payrollRunId])
}

model RemittancePayment {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  kind         String
  amountKobo   BigInt     @default(0)
  status       String     @default("PENDING")
  paidAt       DateTime?
  reference    String?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([payrollRunId, kind])
  @@index([companyId, status])
}

model ExpenseClaim {
  id                   String    @id @default(cuid())
  companyId            String
  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId           String
  employee             Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category             String    @default("OTHER")
  amountKobo           BigInt
  approvedAmountKobo   BigInt    @default(0)
  description          String
  incurredOn           DateTime
  receiptUrl           String?
  status               String    @default("PENDING")
  approvedById         String?
  approvedBy           User?     @relation("ExpenseApprover", fields: [approvedById], references: [id])
  approvedAt           DateTime?
  reviewNote           String?
  reimbursementMethod  String?
  reimbursementRef     String?
  reimbursedAt         DateTime?
  reimbursedById       String?
  reimbursedBy         User?     @relation("ExpenseReimburser", fields: [reimbursedById], references: [id])
  payrollRunId         String?
  payrollRun           PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([companyId, status])
  @@index([employeeId])
  @@index([payrollRunId])
}

model LeaveRequest {
  id          String             @id @default(cuid())
  employeeId  String
  employee    Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        LeaveType
  startDate   DateTime
  endDate     DateTime
  days        Int
  reason      String?
  status      LeaveRequestStatus @default(PENDING)
  approvedById String?
  approvedBy  User?              @relation("LeaveApprover", fields: [approvedById], references: [id])
  approvedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([employeeId, status])
}

model LeaveBalance {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType
  year         Int
  entitledDays Int
  usedDays     Int       @default(0)

  @@unique([employeeId, leaveType, year])
}

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String?
  action      String
  entityType  String
  entityId    String
  performedById String
  performedBy User     @relation(fields: [performedById], references: [id])
  changes     Json?
  timestamp   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([performedById])
  @@index([companyId, timestamp])
}

model Notification {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String
  linkUrl    String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([companyId, createdAt])
}

model GoogleDriveIntegration {
  id                   String   @id @default(cuid())
  companyId            String   @unique
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  refreshToken         String
  email                String?
  folderId             String?
  staffSpreadsheetId   String?
  payrollSpreadsheetId String?
  lastStaffSyncAt      DateTime?
  lastPayrollSyncAt    DateTime?
  lastHrMailSyncAt     DateTime?
  connectedAt          DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model MicrosoftWorkspaceIntegration {
  id                   String   @id @default(cuid())
  companyId            String   @unique
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  refreshToken         String
  email                String?
  folderId             String?
  staffSpreadsheetId   String?
  payrollSpreadsheetId String?
  lastStaffSyncAt      DateTime?
  lastPayrollSyncAt    DateTime?
  connectedAt          DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

enum HrDeskCategory {
  LEAVE
  RESIGNATION
  COMPLAINT
  INQUIRY
  PAYROLL
  GENERAL
}

enum HrDeskStatus {
  NEW
  TRIAGED
  ASSIGNED
  APPROVED
  REJECTED
  CLOSED
}

model HrDeskMessage {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  gmailMessageId  String
  gmailThreadId   String?
  fromEmail       String
  fromName        String?
  subject         String
  snippet         String
  bodyText        String?
  receivedAt      DateTime
  category        HrDeskCategory @default(GENERAL)
  status          HrDeskStatus   @default(NEW)
  employeeId      String?
  employee        Employee?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  /// HR portal user responsible for triaging / closing this mail
  assigneeUserId  String?
  assigneeUser    User?          @relation("HrDeskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  leaveRequestId  String?
  draftMessageId  String?
  notes           String?
  processedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([companyId, gmailMessageId])
  @@index([companyId, status, receivedAt])
  @@index([companyId, category])
  @@index([employeeId])
  @@index([assigneeUserId])
}

enum AttendanceDayStatus {
  PRESENT
  LATE
  PARTIAL
  ABSENT
  ON_LEAVE
  OFF
}

model AttendanceSettings {
  id                      String  @id @default(cuid())
  companyId               String  @unique
  company                 Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Fixed penalty per missed shift in kobo. If 0, use daily basic rate.
  missedShiftPenaltyKobo  BigInt  @default(0)
  /// Minutes after shift start before marking LATE
  lateGraceMinutes        Int     @default(15)
  /// Minimum minutes on site to count as PRESENT (else PARTIAL)
  minPresentMinutes       Int     @default(240)
  updatedAt               DateTime @updatedAt
}

model ShiftTemplate {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  /// "HH:mm" 24h local time
  startTime     String
  endTime       String
  /// Mon=0 … Sun=6 as bitmask string length 7, e.g. "1111100" = Mon–Fri
  workDays      String   @default("1111100")
  graceMinutes  Int      @default(15)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignments   EmployeeShiftAssignment[]
  attendanceDays AttendanceDay[]
  exceptions    ShiftException[]

  @@unique([companyId, name])
  @@index([companyId])
}

model EmployeeShiftAssignment {
  id         String        @id @default(cuid())
  employeeId String        @unique
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId    String
  shift      ShiftTemplate @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  updatedAt  DateTime      @updatedAt

  @@index([shiftId])
}

model AttendancePunch {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deviceUserId String
  employeeId   String?
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  punchedAt    DateTime
  punchType    String?   // IN, OUT, or unknown from machine
  source       String    @default("CSV_IMPORT")
  importBatch  String?
  rawLine      String?
  createdAt    DateTime  @default(now())

  @@unique([companyId, deviceUserId, punchedAt])
  @@index([companyId, punchedAt])
  @@index([employeeId, punchedAt])
}

model AttendanceDay {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate        DateTime
  shiftId         String?
  shift           ShiftTemplate?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  status          AttendanceDayStatus
  clockInAt       DateTime?
  clockOutAt      DateTime?
  workedMinutes   Int                 @default(0)
  lateMinutes     Int                 @default(0)
  expectedMinutes Int                 @default(0)
  penaltyKobo     BigInt              @default(0)
  notes           String?
  compiledAt      DateTime            @default(now())

  @@unique([employeeId, workDate])
  @@index([companyId, workDate, status])
  @@index([companyId, status])
}

model CompanyHoliday {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  workDate  DateTime
  name      String
  /// PUBLIC (national) or COMPANY (declared extra day)
  kind      String   @default("PUBLIC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, workDate])
  @@index([companyId, workDate])
}

model OvertimeRequest {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate       DateTime
  minutes        Int
  reason         String?
  status         String    @default("PENDING")
  amountKobo     BigInt?
  approvedById   String?
  approvedBy     User?     @relation("OvertimeApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  payrollRunId   String?
  payrollRun     PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId, status])
  @@index([employeeId, workDate])
  @@index([payrollRunId])
}

model ShiftException {
  id         String         @id @default(cuid())
  companyId  String
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate   DateTime
  /// OFF = not expected that day. SHIFT = cover a different template for that date.
  kind       String
  shiftId    String?
  shift      ShiftTemplate? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([employeeId, workDate])
  @@index([companyId, workDate])
  @@index([shiftId])
}

enum LifecycleKind {
  ONBOARDING
  OFFBOARDING
}

enum LifecycleStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum LifecycleTaskStatus {
  PENDING
  DONE
  SKIPPED
}

model EmployeeLifecycle {
  id          String          @id @default(cuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind        LifecycleKind
  status      LifecycleStatus @default(OPEN)
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  notes       String?
  tasks       EmployeeLifecycleTask[]

  @@index([companyId, status, kind])
  @@index([employeeId, kind, status])
}

model EmployeeLifecycleTask {
  id            String              @id @default(cuid())
  lifecycleId   String
  lifecycle     EmployeeLifecycle   @relation(fields: [lifecycleId], references: [id], onDelete: Cascade)
  key           String
  title         String
  description   String?
  href          String?
  status        LifecycleTaskStatus @default(PENDING)
  sortOrder     Int                 @default(0)
  completedAt   DateTime?
  completedById String?
  createdAt     DateTime            @default(now())

  @@unique([lifecycleId, key])
  @@index([lifecycleId, status])
}

enum ChangeRequestType {
  BANK
  TAX_RELIEF
  NEXT_OF_KIN
  ADDRESS
  GENERAL
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model EmployeeChangeRequest {
  id           String              @id @default(cuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         ChangeRequestType
  status       ChangeRequestStatus @default(PENDING)
  payload      Json
  note         String?
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([companyId, status, createdAt])
  @@index([employeeId, status])
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum TimesheetWeekStatus {
  OPEN
  SUBMITTED
  VALIDATED
  RETURNED
}

enum WorkspaceFileVisibility {
  EDITORS
  ALL_FULL_TIME
  SPECIFIC
}

model Project {
  id                String            @id @default(cuid())
  companyId         String
  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  code              String?
  description       String?
  status            String            @default("ACTIVE")
  managerEmployeeId String?
  manager           Employee?         @relation("ProjectManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  startsOn          DateTime?
  dueOn             DateTime?
  budgetKobo        BigInt            @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  timesheets        TimesheetEntry[]
  tasks             ProjectTask[]
  members           ProjectMember[]
  scheduleEntries   WorkScheduleEntry[]

  @@unique([companyId, name])
  @@index([companyId, status])
  @@index([managerEmployeeId])
}

model ProjectMember {
  id                    String   @id @default(cuid())
  projectId             String
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId            String
  employee              Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role                  String   @default("MEMBER")
  plannedMinutesPerWeek Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([projectId, employeeId])
  @@index([employeeId])
}

model WorkScheduleEntry {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workDate        DateTime
  plannedMinutes  Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([employeeId, projectId, workDate])
  @@index([companyId, workDate])
  @@index([projectId])
}

model ProjectTask {
  id                 String           @id @default(cuid())
  projectId          String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name               String
  status             String           @default("ACTIVE")
  progress           String           @default("TODO")
  priority           String           @default("MEDIUM")
  assigneeEmployeeId String?
  assignee           Employee?        @relation("TaskAssignee", fields: [assigneeEmployeeId], references: [id], onDelete: SetNull)
  parentTaskId       String?
  parent             ProjectTask?     @relation("TaskTree", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks           ProjectTask[]    @relation("TaskTree")
  dueOn              DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  timesheets         TimesheetEntry[]
  comments           ProjectTaskComment[]
  attachments        ProjectTaskAttachment[]

  @@unique([projectId, name])
  @@index([projectId, status])
  @@index([assigneeEmployeeId])
  @@index([parentTaskId])
}

model ProjectTaskComment {
  id           String      @id @default(cuid())
  taskId       String
  task         ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorUserId String
  author       User        @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  body         String
  createdAt    DateTime    @default(now())

  @@index([taskId, createdAt])
}

model ProjectTaskAttachment {
  id        String      @id @default(cuid())
  taskId    String
  task      ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name      String
  fileUrl   String
  createdAt DateTime    @default(now())

  @@index([taskId])
}

model TimesheetEntry {
  id         String          @id @default(cuid())
  companyId  String
  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId     String
  task       ProjectTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workDate   DateTime
  minutes    Int
  notes      String?
  status     TimesheetStatus @default(DRAFT)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([employeeId, projectId, taskId, workDate])
  @@index([companyId, workDate])
  @@index([employeeId, status])
  @@index([taskId])
}

model TimesheetWeek {
  id            String              @id @default(cuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  weekStart     DateTime
  status        TimesheetWeekStatus @default(SUBMITTED)
  validatedById String?
  validatedBy   User?               @relation("TimesheetWeekValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  validatedAt   DateTime?
  returnReason  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([employeeId, weekStart])
  @@index([companyId, status, weekStart])
}

model JobListing {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title          String
  department     String
  location       String           @default("Nigeria")
  employmentType EmploymentType   @default(FULL_TIME)
  description    String
  requirements   String?
  openings       Int              @default(1)
  deadline       DateTime?
  salaryMinKobo  BigInt?
  salaryMaxKobo  BigInt?
  status         JobListingStatus @default(DRAFT)
  viewCount      Int              @default(0)
  createdById    String?
  createdBy      User?            @relation("JobListingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  publishedAt    DateTime?
  closedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  posts          JobListingPost[]
  applications   JobApplication[]
  requiredSkills JobListingSkill[]

  @@index([companyId, status])
}

model JobListingSkill {
  listingId String
  listing   JobListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([listingId, skillId])
}

model JobListingPost {
  id          String               @id @default(cuid())
  listingId   String
  listing     JobListing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  board       JobBoard
  status      JobListingPostStatus @default(READY)
  externalUrl String?
  lastError   String?
  postedAt    DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([listingId, board])
}

model JobApplication {
  id               String                @id @default(cuid())
  companyId        String
  company          Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  listingId        String
  listing          JobListing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  email            String
  phone            String?
  resumeUrl        String?
  coverLetter      String?
  source           JobBoard              @default(CAREERS_PAGE)
  status           JobApplicationStatus  @default(NEW)
  notes            String?
  interviewAt      DateTime?
  hiredEmployeeId  String?
  hiredEmployee    Employee?             @relation(fields: [hiredEmployeeId], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([listingId, email])
  @@index([listingId, status])
  @@index([companyId, createdAt])
}

model WorkspaceFile {
  id           String                  @id @default(cuid())
  companyId    String
  company      Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  fileUrl      String
  folder       String                  @default("general")
  visibility   WorkspaceFileVisibility @default(EDITORS)
  uploadedById String
  createdAt    DateTime                @default(now())
  grants       WorkspaceFileGrant[]

  @@index([companyId, folder])
}

model WorkspaceFileGrant {
  id         String        @id @default(cuid())
  fileId     String
  file       WorkspaceFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([fileId, employeeId])
}

model TrainingProgram {
  id          String                @id @default(cuid())
  companyId   String
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  required    Boolean               @default(false)
  enrollments TrainingEnrollment[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
}

model TrainingEnrollment {
  id          String          @id @default(cuid())
  programId   String
  program     TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status      String          @default("ASSIGNED")
  assignedAt  DateTime        @default(now())
  completedAt DateTime?
  notes       String?

  @@unique([programId, employeeId])
  @@index([employeeId, status])
}

model PerformanceGoal {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Null for COMPANY and DEPARTMENT goals.
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// COMPANY | DEPARTMENT | INDIVIDUAL
  scope       String    @default("INDIVIDUAL")
  department  String?
  title       String
  target      String
  actual      String    @default("")
  targetValue Float?
  actualValue Float?
  unit        String?
  weight      Int       @default(100)
  periodYear  Int
  periodLabel String    @default("ANNUAL")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([employeeId, periodYear])
  @@index([companyId, periodYear])
  @@index([companyId, scope, periodYear])
}

model PerformanceReview {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodYear      Int
  periodLabel     String    @default("ANNUAL")
  status          String    @default("DRAFT")
  selfNotes       String?
  managerNotes    String?
  peerNotes       String?
  finalNotes      String?
  selfScore       Int?
  managerScore    Int?
  peerScore       Int?
  finalScore      Int?
  peerEmployeeId  String?
  peerEmployee    Employee? @relation("ReviewPeer", fields: [peerEmployeeId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([employeeId, periodYear, periodLabel])
  @@index([companyId, periodYear, status])
  @@index([peerEmployeeId])
}

model Recognition {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  givenById   String
  givenBy     User     @relation("RecognitionGiver", fields: [givenById], references: [id], onDelete: Restrict)
  /// PERFORMANCE | TEAMWORK | INNOVATION | LEADERSHIP | CUSTOMER_SERVICE
  kind        String
  note        String   @default("")
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([employeeId])
  @@index([givenById])
}

model AutomationSettings {
  id                   String   @id @default(cuid())
  companyId            String   @unique
  company              Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expiryLeadDays       Int      @default(60)
  reviewLeadDays       Int      @default(14)
  payrollReminderDay   Int      @default(25)
  /// JSON: { expiry, timesheets, reviews, approvals, payroll, compliance }
  alerts               Json?
  updatedAt            DateTime @updatedAt
}

model AutomationJobLog {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job          String
  createdCount Int      @default(0)
  detail       String   @default("")
  ranAt        DateTime @default(now())

  @@index([companyId, job, ranAt])
}

model WebhookEndpoint {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  url         String
  secret      String
  /// JSON string[] of event names
  events      Json
  enabled     Boolean   @default(true)
  lastStatus  Int?
  lastError   String    @default("")
  lastFiredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId, enabled])
}

